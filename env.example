# Puerto del servidor
PORT=8080

# Proyecto de GCP (para Vertex AI LLM, Embeddings y Firestore - usar el ID del proyecto)
# IMPORTANTE: Se requiere autenticación con Service Account o ADC (Application Default Credentials)
GCP_PROJECT=sodium-pager-473602-n7

# Configuración de Qdrant Cloud
QDRANT_URL=https://tu-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=tu-api-key-aqui
QDRANT_COLLECTION_NAME=metrologia_docs

# Configuración de Firestore (requiere autenticación con gcloud)
FIRESTORE_DATABASE=pln-proyecto
FIRESTORE_COLLECTION=logs-agente

# Modelo de embeddings (usado en el notebook de ingesta)
EMBEDDING_MODEL=gemini-embedding-001

# Modelo de generación (LLM) - Usando Vertex AI
LLM_MODEL=gemini-2.5-flash
